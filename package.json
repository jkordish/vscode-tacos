{
  "name": "vscode-tacos",
  "displayName": "TaCoS Resume Brief",
  "description": "Auto task-context summaries when you resume work in VS Code.",
  "license": "MIT",
  "version": "0.1.0",
  "publisher": "jkordish",
  "repository": {
    "type": "git",
    "url": "https://github.com/jkordish/vscode-tacos.git"
  },
  "bugs": {
    "url": "https://github.com/jkordish/vscode-tacos/issues"
  },
  "homepage": "https://github.com/jkordish/vscode-tacos#readme",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "TaCoS runs in safe mode in Restricted Mode: git execution, terminal command collection, and restore actions that execute tooling are disabled until trust is granted.",
      "restrictedConfigurations": [
        "tacos.summaryProvider",
        "tacos.openaiBaseUrl",
        "tacos.openaiModel"
      ]
    }
  },
  "categories": [
    "Other",
    "Testing",
    "SCM Providers"
  ],
  "keywords": [
    "resume",
    "context",
    "productivity",
    "git",
    "ai",
    "privacy",
    "safety"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:tacos.slash",
    "onCommand:tacos.showNow",
    "onCommand:tacos.copyPromptAndOpenCodex",
    "onCommand:tacos.showLastSummary",
    "onCommand:tacos.jumpToLastEdit",
    "onCommand:tacos.setPrivacyPreset",
    "onCommand:tacos.setRetentionPolicy",
    "onCommand:tacos.forgetWorkspaceNow",
    "onCommand:tacos.revokeAiPayloadConsent",
    "onCommand:tacos.rateSummaryHelpfulness",
    "onCommand:tacos.pauseSummaries",
    "onCommand:tacos.snoozeAutoSummaries",
    "onCommand:tacos.generateStandupUpdate",
    "onCommand:tacos.restoreWorkingSet",
    "onCommand:tacos.captureRestoreSearchQuery",
    "onCommand:tacos.resumeSummaries",
    "onCommand:tacos.toggleEnabled",
    "onCommand:tacos.pauseUntilRestart",
    "onCommand:tacos.exportMetrics",
    "onCommand:tacos.addVisitedUrl",
    "onCommand:tacos.addCheckpointNote",
    "onCommand:tacos.addCheckpointNoteFromClipboard",
    "onCommand:tacos.clearCheckpointNote",
    "onCommand:tacos.configureAiProvider",
    "onCommand:tacos.openPrivacySafety",
    "onCommand:tacos.clearCorrections",
    "onCommand:tacos.setOpenAiApiKey",
    "onCommand:tacos.clearOpenAiApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tacos.slash",
        "title": "TaCoS: Resume Summary Quick"
      },
      {
        "command": "tacos.showNow",
        "title": "TaCoS: Show Resume Brief Now"
      },
      {
        "command": "tacos.copyPromptAndOpenCodex",
        "title": "TaCoS: Copy Prompt and Open Codex"
      },
      {
        "command": "tacos.showLastSummary",
        "title": "TaCoS: Show Last Summary"
      },
      {
        "command": "tacos.jumpToLastEdit",
        "title": "TaCoS: Jump to Last Edit"
      },
      {
        "command": "tacos.setPrivacyPreset",
        "title": "TaCoS: Set Privacy Preset"
      },
      {
        "command": "tacos.setRetentionPolicy",
        "title": "TaCoS: Set Retention Policy"
      },
      {
        "command": "tacos.forgetWorkspaceNow",
        "title": "TaCoS: Forget This Workspace Now"
      },
      {
        "command": "tacos.revokeAiPayloadConsent",
        "title": "TaCoS: Revoke AI Payload Consent"
      },
      {
        "command": "tacos.rateSummaryHelpfulness",
        "title": "TaCoS: Rate Summary Helpfulness"
      },
      {
        "command": "tacos.pauseSummaries",
        "title": "TaCoS: Pause Auto Summaries"
      },
      {
        "command": "tacos.snoozeAutoSummaries",
        "title": "TaCoS: Snooze Auto Summaries"
      },
      {
        "command": "tacos.generateStandupUpdate",
        "title": "TaCoS: Generate Standup Update"
      },
      {
        "command": "tacos.restoreWorkingSet",
        "title": "TaCoS: Restore Working Set"
      },
      {
        "command": "tacos.captureRestoreSearchQuery",
        "title": "TaCoS: Set Restore Search Query"
      },
      {
        "command": "tacos.resumeSummaries",
        "title": "TaCoS: Resume Auto Summaries"
      },
      {
        "command": "tacos.toggleEnabled",
        "title": "TaCoS: Toggle Summaries Enabled"
      },
      {
        "command": "tacos.pauseUntilRestart",
        "title": "TaCoS: Pause Summaries Until Restart"
      },
      {
        "command": "tacos.exportMetrics",
        "title": "TaCoS: Export Local Metrics"
      },
      {
        "command": "tacos.addVisitedUrl",
        "title": "TaCoS: Add Recent URL"
      },
      {
        "command": "tacos.addCheckpointNote",
        "title": "TaCoS: Add Checkpoint Note"
      },
      {
        "command": "tacos.addCheckpointNoteFromClipboard",
        "title": "TaCoS: Add Checkpoint Note from Clipboard"
      },
      {
        "command": "tacos.clearCheckpointNote",
        "title": "TaCoS: Clear Checkpoint Note"
      },
      {
        "command": "tacos.configureAiProvider",
        "title": "TaCoS: Configure AI Provider"
      },
      {
        "command": "tacos.openPrivacySafety",
        "title": "TaCoS: Privacy & Safety"
      },
      {
        "command": "tacos.clearCorrections",
        "title": "TaCoS: Clear Summary Corrections"
      },
      {
        "command": "tacos.setOpenAiApiKey",
        "title": "TaCoS: Set OpenAI API Key"
      },
      {
        "command": "tacos.clearOpenAiApiKey",
        "title": "TaCoS: Clear OpenAI API Key"
      }
    ],
    "configuration": {
      "title": "TaCoS",
      "properties": {
        "tacos.showOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show a resume brief when VS Code regains focus after idle."
        },
        "tacos.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for automatic TaCoS summaries."
        },
        "tacos.pauseSummaries": {
          "type": "boolean",
          "default": false,
          "description": "Temporarily disable auto summaries without uninstalling the extension."
        },
        "tacos.showTimeline": {
          "type": "boolean",
          "default": true,
          "description": "Show the optional timeline section in the details panel (collapsed by default)."
        },
        "tacos.promptCheckpointOnBlur": {
          "type": "boolean",
          "default": false,
          "description": "Prompt for an optional one-line Future Me checkpoint note when VS Code loses focus after meaningful activity."
        },
        "tacos.minIdleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Minimum idle minutes before auto summary may trigger."
        },
        "tacos.cooldownMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Cooldown in minutes between automatic summaries."
        },
        "tacos.summaryQuietHours": {
          "type": "string",
          "default": "",
          "description": "Optional quiet window for auto summaries in `HH:MM-HH:MM` format, for example `22:00-07:00`."
        },
        "tacos.includeDiff": {
          "type": "boolean",
          "default": false,
          "description": "Include truncated git diff text in the details and Codex prompt."
        },
        "tacos.maxDiffChars": {
          "type": "number",
          "default": 6000,
          "minimum": 0,
          "description": "Maximum characters of git diff included when enabled."
        },
        "tacos.includeTerminalHistory": {
          "type": "boolean",
          "default": false,
          "description": "Include recent terminal commands when shell integration is available."
        },
        "tacos.includeDebugHistory": {
          "type": "boolean",
          "default": false,
          "description": "Include recent debug sessions in context collection."
        },
        "tacos.cacheIfContextUnchanged": {
          "type": "boolean",
          "default": true,
          "description": "Reuse the previous summary when no meaningful context changed."
        },
        "tacos.redactionPatterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional regex patterns to redact from collected context."
        },
        "tacos.privacyPreset": {
          "type": "string",
          "enum": [
            "minimal",
            "balanced",
            "max-context"
          ],
          "default": "minimal",
          "description": "Privacy behavior preset. `minimal` (default) limits context collection, `balanced` enables terminal/debug context locally, `max-context` enables richer local context."
        },
        "tacos.retentionPolicy": {
          "type": "string",
          "enum": [
            "1d",
            "7d",
            "30d",
            "forever"
          ],
          "default": "7d",
          "description": "How long TaCoS keeps workspace-scoped context and metrics before pruning."
        },
        "tacos.metricsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Track local resumption/edit lag metrics in workspace state."
        },
        "tacos.uiSurface": {
          "type": "string",
          "enum": [
            "statusbar",
            "notification",
            "silent"
          ],
          "default": "statusbar",
          "description": "Primary UI surface for focus-triggered summaries. `statusbar` is ambient (default), `notification` shows actionable toasts, and `silent` only updates cached/status context."
        },
        "tacos.autoRefreshInBackground": {
          "type": "boolean",
          "default": true,
          "description": "Legacy compatibility toggle for focus presentation mode. Prefer `tacos.uiSurface` for new setups."
        },
        "tacos.companionNudgesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable companion nudges in the details panel based on recent context and blockers."
        },
        "tacos.companionNudgeAggressiveness": {
          "type": "string",
          "enum": [
            "low",
            "balanced",
            "high"
          ],
          "default": "balanced",
          "description": "Companion nudge sensitivity. `low` surfaces only high-confidence nudges; `high` surfaces broader guidance."
        },
        "tacos.companionNudgeQuietHours": {
          "type": "string",
          "default": "",
          "description": "Optional local quiet window for nudges in `HH:MM-HH:MM` format, for example `22:00-07:00`."
        },
        "tacos.companionNudgeCooldownMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Minimum minutes between companion nudges in the same workspace."
        },
        "tacos.summaryProvider": {
          "type": "string",
          "enum": [
            "local",
            "vscode-lm",
            "openai"
          ],
          "default": "local",
          "description": "Summary generation mode. `vscode-lm` uses a model selected via the Configure AI Provider command; `openai` uses a direct API call with strict JSON schema."
        },
        "tacos.openaiModel": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "description": "OpenAI model used when `summaryProvider` is `openai`."
        },
        "tacos.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI-compatible endpoints."
        },
        "tacos.openaiTimeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Timeout for direct OpenAI summary requests."
        },
        "tacos.codexOpenCommand": {
          "type": "string",
          "default": "",
          "description": "Optional VS Code command id to open the Codex panel (used by Copy + Open flow)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md,yml,yaml,cjs}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md,yml,yaml,cjs}\"",
    "test": "jest --runInBand",
    "test:integration": "node ./test/integration/runTest.js",
    "verify:quick": "npm run format:check && npm run lint && npm run compile && npm test",
    "verify": "npm run verify:quick && npm run test:integration && npx @vscode/vsce package --no-dependencies --out vscode-tacos-verify.vsix",
    "package:vsix": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@swc/core": "^1.15.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.7.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^30.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "markdown-it": "^14.1.1"
  }
}
